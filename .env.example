# Safe local defaults. Copy to .env; never commit credentials.
KG_SERVICE_NAME=knowledge-graph-api
KG_ENVIRONMENT=local
KG_DATA_AS_OF=2026-01-31
KG_ARTIFACT_DIR=artifacts
KG_LOG_LEVEL=INFO
KG_API_KEY=
KG_MAX_QUESTION_LENGTH=1000
KG_MAX_EVIDENCE_ROWS=50
KG_MAX_QUERY_ROWS=1000
KG_QUERY_TIMEOUT_SECONDS=5

# type-10052026-Maurice: Local-only Compose defaults; replace passwords before sharing a network.
CRM_POSTGRES_DB=crm
CRM_POSTGRES_USER=crm_reader
CRM_POSTGRES_PASSWORD=crm_local_only
CRM_POSTGRES_PORT=5433
VECTOR_POSTGRES_DB=vectors
VECTOR_POSTGRES_USER=vector_reader
VECTOR_POSTGRES_PASSWORD=vector_local_only
VECTOR_POSTGRES_PORT=5434
FUSEKI_ADMIN_PASSWORD=fuseki_local_only
FUSEKI_PORT=3030
API_PORT=8000
ETL_RUN_ID=compose-run
